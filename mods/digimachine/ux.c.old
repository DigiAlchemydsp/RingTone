/* SPDX-License-Identifier: GPL-2.0-or-later
 * digimachine UX: the machine toggle and the SYN/FILT/AMP pages.
 * Digitone mk1 / Keys, OS 1.43.
 *
 * Minimal, stateless design: no picker, no modal sequences.
 *   - UP    on a MIDI track  -> machine ON  (WAVETABLE)
 *   - DOWN  on a MIDI track  -> machine OFF (plain MIDI)
 *   - SYN1 / FLTR / AMP      -> switch our sub-page
 *   - NO                     -> hide our page (back to the stock page)
 *   - any encoder            -> edits the current sub-page's parameter
 *
 * Key records reach us through the UI-queue tap (key_glue.s) because the stock
 * UI task consumes key events before the core ev_key bus when it is live; the
 * same records also arrive on ev_key, so both paths call dmachine_key_impl.
 * Key ids (devices/digitone.toml): SYN1 21, FLTR 23, AMP 24, NO 14, UP 15,
 * DOWN 16.
 */
#include "../../src/corea.h"

#define DM_TEXTF      ((void (*)(void *, const void *, int, int, int, const char *, ...))0x400DDE68)
#define DM_FONT5      ((const void *)0x402315C8)
#define DM_FILLRECT   ((void (*)(void *, int, int, int, int, int))0x400DD292)
#define DM_INVALIDATE ((void (*)(void *))0x400E512A)

enum { DM_PAGE_SYN, DM_PAGE_FILT, DM_PAGE_AMP, DM_PAGE_N };
static const char *const dm_page_name[DM_PAGE_N] = { "SYN", "FILT", "AMP" };

/* per-MIDI-track machine selection (0 = plain MIDI). One machine for v1; the
 * track index is fixed at 0 until the current-track read lands. */
int dmachine_track_mach[4] = { 0, 0, 0, 0 };

/* UI state */
static int ux_page = DM_PAGE_SYN;   /* the current sub-page */
static int ux_visible;              /* our page was drawn this frame */
static int ux_redraw;               /* ask ev_tick to invalidate */
static int ux_page_mode;            /* our page is being shown (until NO) */

/* parameters (exported; the page edits these; machine.c pushes them) */
extern int dmachine_on, dmachine_inc, dmachine_detune, dmachine_width;
extern int dmachine_morph, dmachine_level, dmachine_pan;
extern int dmachine_filt_type, dmachine_filt_freq, dmachine_filt_reso, dmachine_filt_env;
extern int dmachine_amp_a, dmachine_amp_d, dmachine_amp_s, dmachine_amp_r;
extern int dmachine_send_delay, dmachine_send_reverb, dmachine_send_od;

/* key ids (runtime) */
#define K_SYN  21
#define K_FLTR 23
#define K_AMP  24
#define K_NO   14
#define K_UP   15
#define K_DOWN 16

static int clampi(int v, int lo, int hi)
{
    return v < lo ? lo : (v > hi ? hi : v);
}

static int is_press(int flags)
{
    return (flags & 1) && !(flags & 0x10);
}

/* ---- the key logic, shared by ev_key and the UI-queue tap ---- */
int dmachine_key_impl(int id, int flags)
{
    if (!is_press(flags))
        return 0;

    switch (id) {
    case K_UP:                              /* machine on (stock nav still runs) */
        dmachine_on = 1;
        dmachine_track_mach[0] = 1;
        ux_page_mode = 1;
        ux_redraw = 1;
        return 0;
    case K_DOWN:                            /* machine off (plain MIDI) */
        if (dmachine_on || ux_page_mode) {
            dmachine_on = 0;
            dmachine_track_mach[0] = 0;
            ux_page_mode = 0;
            ux_redraw = 1;
        }
        return 0;
    case K_SYN:
        ux_page = DM_PAGE_SYN; ux_page_mode = 1; ux_redraw = 1; return 1;
    case K_FLTR:
        ux_page = DM_PAGE_FILT; ux_page_mode = 1; ux_redraw = 1; return 1;
    case K_AMP:
        ux_page = DM_PAGE_AMP; ux_page_mode = 1; ux_redraw = 1; return 1;
    case K_NO:
        if (!ux_page_mode)
            return 0;
        ux_page_mode = 0;                   /* hide our page */
        ux_redraw = 1;
        return 1;
    default:
        return 0;
    }
}

/* ---- ev_key ---- */
int dmachine_key(void *brain, void *ev)
{
    (void)brain;
    return dmachine_key_impl(*(int *)((char *)ev + 12), *(int *)((char *)ev + 16));
}

/* ---- the UI-queue tap (key_glue.s) ---- */
int dmachine_key_record(int code, int flags)
{
    return dmachine_key_impl(code, flags);
}


/* ---- ev_enc ---- */
int dmachine_enc(void *brain, void *ev)
{
    int id = *(int *)((char *)ev + 12);
    int d = *(int *)((char *)ev + 16);
    (void)brain;
    if (!ux_page_mode || !d)
        return 0;
    switch (ux_page) {
    case DM_PAGE_SYN:
        switch (id) {
        case 1: dmachine_inc = clampi(dmachine_inc + d * 16, 0, 200000); break;
        case 2: dmachine_detune = clampi(dmachine_detune + d * 8, -4096, 4096); break;
        case 3: dmachine_width = clampi(dmachine_width + d * 256, 0, 16384); break;
        case 4: dmachine_morph = clampi(dmachine_morph + d * 256, 0, 7 * 256); break;
        case 5: dmachine_level = clampi(dmachine_level + d * 512, 0, 32767); break;
        case 6: dmachine_pan = clampi(dmachine_pan + d * 256, -8192, 8191); break;
        default: return 0;
        }
        break;
    case DM_PAGE_FILT:
        switch (id) {
        case 1: dmachine_filt_type = clampi(dmachine_filt_type + (d > 0 ? 1 : -1), 0, 3); break;
        case 2: dmachine_filt_freq = clampi(dmachine_filt_freq + d, 0, 127); break;
        case 3: dmachine_filt_reso = clampi(dmachine_filt_reso + d, 0, 15); break;
        case 4: dmachine_filt_env = clampi(dmachine_filt_env + d * 128, -8192, 8192); break;
        default: return 0;
        }
        break;
    case DM_PAGE_AMP:
        switch (id) {
        case 1: dmachine_amp_a = clampi(dmachine_amp_a + d, 0, 255); break;
        case 2: dmachine_amp_d = clampi(dmachine_amp_d + d, 0, 255); break;
        case 3: dmachine_amp_s = clampi(dmachine_amp_s + d * 256, 0, 32767); break;
        case 4: dmachine_amp_r = clampi(dmachine_amp_r + d, 0, 255); break;
        case 5: dmachine_level = clampi(dmachine_level + d * 512, 0, 32767); break;
        case 6: dmachine_send_delay = clampi(dmachine_send_delay + d * 512, 0, 32767); break;
        case 7: dmachine_send_reverb = clampi(dmachine_send_reverb + d * 512, 0, 32767); break;
        case 8: dmachine_send_od = clampi(dmachine_send_od + d * 512, 0, 32767); break;
        default: return 0;
        }
        break;
    default:
        return 0;
    }
    ux_redraw = 1;
    return 1;
}

/* ---- ev_tick ---- */
void dmachine_tick(void *ctrl)
{
    static int booted;
    (void)ctrl;
    if (!booted) {
        extern void dmachine_boot(void);
        dmachine_boot();
        booted = 1;
    }
    if (ux_page_mode)
        ux_redraw = 1;
}

/* ---- ev_draw ---- */
void dmachine_draw(void *bmp, void *ctrl)
{
    (void)ctrl;
    ux_visible = ux_page_mode;
    if (!ux_visible)
        return;
    DM_FILLRECT(bmp, 0, 0, 127, 52, 0);              /* clear the body */
    DM_TEXTF(bmp, DM_FONT5, 1, 48, -1, "WAVETABLE  %s", dm_page_name[ux_page]);
    switch (ux_page) {
    case DM_PAGE_SYN:
        DM_TEXTF(bmp, DM_FONT5, 1, 38, -1, "TUNE   %d", dmachine_inc);
        DM_TEXTF(bmp, DM_FONT5, 1, 30, -1, "DETUNE %d", dmachine_detune);
        DM_TEXTF(bmp, DM_FONT5, 1, 22, -1, "WIDTH  %d", dmachine_width);
        DM_TEXTF(bmp, DM_FONT5, 1, 14, -1, "MORPH  %d", dmachine_morph);
        DM_TEXTF(bmp, DM_FONT5, 1, 6, -1, "LEVEL  %d   PAN %d", dmachine_level, dmachine_pan);
        break;
    case DM_PAGE_FILT:
        DM_TEXTF(bmp, DM_FONT5, 1, 38, -1, "TYPE   %d", dmachine_filt_type);
        DM_TEXTF(bmp, DM_FONT5, 1, 30, -1, "FREQ   %d", dmachine_filt_freq);
        DM_TEXTF(bmp, DM_FONT5, 1, 22, -1, "RESO   %d", dmachine_filt_reso);
        DM_TEXTF(bmp, DM_FONT5, 1, 14, -1, "ENV DEPTH %d", dmachine_filt_env);
        DM_TEXTF(bmp, DM_FONT5, 1, 6, -1, "NO = back");
        break;
    case DM_PAGE_AMP:
        DM_TEXTF(bmp, DM_FONT5, 1, 38, -1, "ATK %d  DEC %d", dmachine_amp_a, dmachine_amp_d);
        DM_TEXTF(bmp, DM_FONT5, 1, 30, -1, "SUS %d  REL %d", dmachine_amp_s, dmachine_amp_r);
        DM_TEXTF(bmp, DM_FONT5, 1, 22, -1, "LEVEL %d", dmachine_level);
        DM_TEXTF(bmp, DM_FONT5, 1, 14, -1, "SND D %d  R %d", dmachine_send_delay, dmachine_send_reverb);
        DM_TEXTF(bmp, DM_FONT5, 1, 6, -1, "SND OD %d", dmachine_send_od);
        break;
    default:
        break;
    }
}

void dmachine_set_visible(int v)
{
    ux_visible = v;
}
