| digimachine: the UI-queue tap. The stock UI task consumes key events before the
| core ev_key bus when it is live, so we read the raw 16-byte UI records at
| queue_send's entry (0x40001cda) instead.
|
| queue_send(queue*, item*): 4(sp) = queue, 8(sp) = item.
| item: +0 type (byte), +4 code (long), +8 flags (long).
| Only the UI queue (0x4052a6bc) is inspected -- queue_send serves other queues
| during boot, before our .run is mapped, so touching our data then would fault.
| For a type-0 record we call dmachine_key_record(code, flags); a nonzero return
| drops the record so the stock UI does not also act on it.
|
| A normal C call: d0/d1/a0/a1 free; the rest preserved.

        .section .run, "ax"
        .balign 2
        .globl  digimachine_keytap
digimachine_keytap:
        move.l  4(%a7), %d0
        cmp.l   #0x4052a6bc, %d0                | the UI queue only
        bne     .Lraw
        movea.l 8(%a7), %a0                     | item
        tst.b   %a0@                            | type 0 = key
        bne     .Lraw
        move.l  4(%a0), %d0                     | code
        move.l  8(%a0), %d1                     | flags
        move.l  %d1, -(%a7)                     | push flags (2nd arg) first
        move.l  %d0, -(%a7)                     | then code (1st arg)
        jsr     dmachine_key_record
        addq.l  #8, %a7
        tst.l   %d0
        bne     .Ltake
.Lraw:
        move.l  %a2, -(%a7)                     | the displaced prologue:
        move.l  %d2, -(%a7)                      |   movel %a2,%sp@-
        movea.l 0xc(%a7), %a0                    |   movel %d2,%sp@-
        jmp     0x40001ce2                       |   moveal %sp@(12),%a0
.Ltake:
        rts                                      | drop the event
